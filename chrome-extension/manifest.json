{
  "manifest_version": 3,
  "name": "Rhea Browser Bridge",
  "version": "0.2.2",
  "description": "Lets the local Rhea assistant read and operate your Chrome tabs.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Rhea Browser Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
