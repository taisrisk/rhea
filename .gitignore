# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local secrets and OAuth state
.env
.env.*
!.env.example
secrets/
tokens.json
oauth-token.json

# Build outputs
build/
dist/
*.egg-info/
/target/
/target-*/
/Rhea*.exe
/rhea*.exe
*.pdb
*.dSYM/
*.app/
*.dmg
*.msi
*.zip

# Operating-system and editor artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch and temporary files
*.tmp
*.bak
*.old

# Local captures and debug output
captures/
debug-screens/
*.log

# Obsidian local workspace state is user-specific; keep the vault itself.
RHEA VAULT/.obsidian/workspace.json
RHEA VAULT/.obsidian/cache/

# Release output made by build.ps1 (the exe is uploaded to the GitHub release, never committed)
/dist/
*.rar

# The local model runtime and downloads live in ~/.rhea/laya, never in the repo
/laya/
/laya-*/
*.safetensors
*.onnx

# Local-only tooling, planning notes and captures
*.exe
captures/
/.taste-skill/
/.planning/
/.cargo/
/.claude/
